<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <include
        android:id="@+id/toolbar_layout"
        layout="@layout/toolbar_layout" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/toolbar_layout">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="12dp"
            android:paddingEnd="24dp"
            android:paddingBottom="12dp">

            <org.schabi.newpipe.views.NewPipeTextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:text="@string/msg_name" />

            <org.schabi.newpipe.views.NewPipeEditText
                android:id="@+id/file_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:inputType="text"
                android:maxLines="1" />

            <org.schabi.newpipe.views.NewPipeTextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:gravity="center"
                android:text="@string/clip_time_range" />

            <com.google.android.material.slider.RangeSlider
                android:id="@+id/time_range_slider"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="0dp"
                android:stepSize="1"
                android:valueFrom="0"
                android:valueTo="3600"
                app:labelBehavior="floating"
                app:trackHeight="4dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <org.schabi.newpipe.views.NewPipeEditText
                    android:id="@+id/start_time_edit"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:inputType="time"
                    android:maxLines="1" />

                <org.schabi.newpipe.views.NewPipeTextView
                    android:id="@+id/clip_duration_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp"
                    android:gravity="center"
                    tools:text="5s" />

                <org.schabi.newpipe.views.NewPipeEditText
                    android:id="@+id/end_time_edit"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:inputType="time"
                    android:maxLines="1" />

            </LinearLayout>

            <org.schabi.newpipe.views.NewPipeTextView
                android:id="@+id/clip_duration_warning"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:gravity="center"
                android:text="@string/gif_long_clip_warning"
                android:textColor="?attr/colorError"
                android:visibility="gone"
                tools:visibility="visible" />

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/format_group"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                app:checkedButton="@id/format_gif"
                app:selectionRequired="true"
                app:singleSelection="true"
                tools:ignore="RtlHardcoded">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/format_gif"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/gif_format_gif" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/format_webp"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/gif_format_webp" />

            </com.google.android.material.button.MaterialButtonToggleGroup>

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/optimize_checkbox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:checked="true"
                android:text="@string/gif_optimize" />

            <Button
                android:id="@+id/add_text_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/gif_add_text"
                style="?android:attr/borderlessButtonStyle" />

        </LinearLayout>
    </ScrollView>
</RelativeLayout>
